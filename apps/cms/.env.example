# Neon PostgreSQL — pooled connection string (host contains "-pooler")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Public URL of the static web site (apps/web), used for SEO previews in the admin
WEB_URL=http://localhost:3001

# Render Deploy Hook of the static web site. Leave empty locally to skip rebuild triggers
WEB_DEPLOY_HOOK_URL=

# Backblaze B2 private bucket (S3-compatible). Leave S3_BUCKET empty to store media locally in public/media
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_REGION=us-west-004
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
